# LLM provider: anthropic | bedrock (empty = auto: ANTHROPIC_API_KEY first, then AWS keys)
LLM_PROVIDER=

# Option A: Anthropic API
ANTHROPIC_API_KEY=

# Option B: Amazon Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
BEDROCK_PROFILE_PREFIX=us

# Models: first-party IDs (claude-sonnet-5-5) or Bedrock IDs as-is
AGENT_MODEL=us.anthropic.claude-sonnet-4-6
LIGHT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
